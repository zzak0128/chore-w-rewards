@page "/TaskItems"
@using KidsPointTracker.Shared.Models
@using KidsPointTracker.Shared.Services
@inject ISnackbar Snackbar
@inject IDialogService DialogService 
@inject TaskService TaskService

<MudPaper>
    <MudDataGrid @ref="_dataGrid"
                 T="TaskItem"
             Items="@_taskItems"
             ReadOnly="false"
             EditMode="DataGridEditMode.Inline"
             EditTrigger="DataGridEditTrigger.Manual"
             StartedEditingItem="@StartedEditingItem"
             CanceledEditingItem="@CanceledEditingItem"
             CommittedItemChanges="@CommittedItemChanges"
             Bordered="true"
             Hover="true">
        <ToolBarContent>
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline">
                <MudText Typo="Typo.h4">Tasks</MudText>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateTaskItem" StartIcon="@Icons.Material.Filled.Add" >Add New</MudButton>
            </MudStack>
        </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Task">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Name"
                              Margin="Margin.Dense"
                              Required="true"
                              Immediate="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.PointValue" Title="Point Value">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.PointValue"
                                 Margin="Margin.Dense"
                                 Immediate="true"
                                 Step="10"/>
            </EditTemplate>
        </PropertyColumn>
        
        @* Actions column - shows Edit button or Save/Cancel buttons based on edit state *@
        <TemplateColumn>
            <CellTemplate>
                <MudStack Row Spacing="0" Justify="Justify.FlexEnd">
                    @if (context.IsEditing)
                    {
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Check"
                                       Color="Color.Success"
                                       aria-label="Save changes"
                                       OnClick="@context.Actions.CommitEditingItemAsync" />
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Error"
                                       aria-label="Cancel editing"
                                       OnClick="@context.Actions.CancelEditingItemAsync" />
                    }
                    else
                    {
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Outlined.Edit"
                                       Disabled="@_isEditing"
                                       aria-label="Edit row"
                                       OnClick="@context.Actions.StartEditingItemAsync" />
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Outlined.Delete"
                                       Disabled="@_isEditing"
                                       aria-label="Delete row"
                                       OnClick="@(() => DeleteItem(context.Item))" />
                    }
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
</MudPaper>

@code {
    private MudDataGrid<TaskItem> _dataGrid = null!;
    private List<TaskItem> _taskItems = [];
    private bool _isEditing;
    
    protected override async Task OnInitializedAsync()
    {
        _taskItems = await TaskService.GetTasksAsync();
    }
    
    private async Task CreateTaskItem()
    {
        var createDialog = await DialogService.ShowAsync<CreateTaskItem>("Add a new Task");

        var result = await createDialog.Result;
        if (!result!.Canceled)
        {
            TaskItem? newTaskItem = await createDialog.GetReturnValueAsync<TaskItem>();
            if (newTaskItem is not null)
            {
                createDialog.Close();
                
                await TaskService.CreateTaskItemAsync(newTaskItem);
                _taskItems = await TaskService.GetTasksAsync();
            }
            else
            {
                Snackbar.Add("Failed to Save the new Task", Severity.Error);
            }
        }
    }
    
    private void StartedEditingItem(TaskItem item)
    {
        _isEditing = true;
    }

    private Task<DataGridEditFormAction> CanceledEditingItem(TaskItem item)
    {
        _isEditing = false;

        return Task.FromResult(DataGridEditFormAction.Close);
    }

    private async Task<DataGridEditFormAction> CommittedItemChanges(TaskItem item)
    {
        // Perform validation
        if (string.IsNullOrWhiteSpace(item.Name))
        {
            return DataGridEditFormAction.KeepOpen;
        }
        
        try
        {
            await TaskService.UpdateTaskItemAsync(item);
        }
        catch (Exception e)
        {
            Snackbar.Add("Failed to Save the Task", Severity.Error);
            
            return DataGridEditFormAction.KeepOpen;
        }
        
        _isEditing = false;
        _taskItems = await TaskService.GetTasksAsync();

        return DataGridEditFormAction.Close;
    }

    private async Task DeleteItem(TaskItem item)
    {
        await TaskService.DeleteTaskItemAsync(item);
        
        _taskItems.Remove(item);
    } 

}