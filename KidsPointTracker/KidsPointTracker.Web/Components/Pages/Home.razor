@page "/"
@using KidsPointTracker.Shared.Models.DTOs
@using KidsPointTracker.Shared.Services
@inject DashboardService DashboardService

<PageTitle>Home</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline">
    <MudText Typo="Typo.h2">Home</MudText>
    <MudButton OnClick="RefreshDataAsync" StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Filled" Color="Color.Primary">Refresh</MudButton>
</MudStack>
<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <MudGrid>
        @foreach (var item in _dashboardItems)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;"><MudStack>
                    <MudText>@item.UserName</MudText>
                    <MudText>@item.Points</MudText>
                </MudStack></MudPaper>
            </MudItem>
        }

