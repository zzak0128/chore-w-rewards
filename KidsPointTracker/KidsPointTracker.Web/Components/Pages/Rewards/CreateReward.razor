@using KidsPointTracker.Shared.Models
<MudDialog>
    <TitleContent>
        @MudDialog.Title
    </TitleContent>
    <DialogContent>
        <MudForm @ref="@_form" @bind-IsValid="@_success" @bind-Errors="@_errors" OnEnterPressed="ReturnReward">
            <MudFocusTrap>
                <MudTextField @bind-Value="NewReward?.Name" Label="Reward" Required="true" Variant="Variant.Outlined"
                              RequiredError="A name is required for a new Reward."/>
                <MudNumericField @bind-Value="NewReward?.PointValue" Label="Point Value" Variant="Variant.Outlined"
                                 Step="10"/>
            </MudFocusTrap>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="() => MudDialog.Cancel()" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="ReturnReward" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private Reward? NewReward { get; } = new();
    private MudForm _form = null!;
    private bool _success;
    private string[] _errors = [];

    private async Task ReturnReward()
    {
        await _form.ValidateAsync();
        if (_form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(NewReward));
        }
    }

}