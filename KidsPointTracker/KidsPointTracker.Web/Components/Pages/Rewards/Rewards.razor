@page "/Rewards"
@using KidsPointTracker.Shared.Database
@using KidsPointTracker.Shared.Models
@using KidsPointTracker.Shared.Services
@using Microsoft.EntityFrameworkCore
@inject ISnackbar Snackbar
@inject IDialogService DialogService 
@inject RewardService RewardService

<MudPaper>
    <MudDataGrid @ref="_dataGrid"
                 T="Reward"
             Items="@_rewards"
             ReadOnly="false"
             EditMode="DataGridEditMode.Inline"
             EditTrigger="DataGridEditTrigger.Manual"
             StartedEditingItem="@StartedEditingItem"
             CanceledEditingItem="@CanceledEditingItem"
             CommittedItemChanges="@CommittedItemChanges"
             Bordered="true"
             Hover="true">
        <ToolBarContent>
            <MudStack>
                <MudText Typo="Typo.h6">Rewards</MudText>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateReward" StartIcon="@Icons.Material.Filled.Add" >Add New</MudButton>
            </MudStack>
        </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Task">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Name"
                              Margin="Margin.Dense"
                              Required="true"
                              Immediate="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.PointValue" Title="Point Value">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.PointValue"
                                 Margin="Margin.Dense"
                                 Immediate="true"
                                 Step="10"/>
            </EditTemplate>
        </PropertyColumn>
        
        @* Actions column - shows Edit button or Save/Cancel buttons based on edit state *@
        <TemplateColumn>
            <CellTemplate>
                <MudStack Row Spacing="0" Justify="Justify.FlexEnd">
                    @if (context.IsEditing)
                    {
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Check"
                                       Color="Color.Success"
                                       aria-label="Save changes"
                                       OnClick="@context.Actions.CommitEditingItemAsync" />
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Error"
                                       aria-label="Cancel editing"
                                       OnClick="@context.Actions.CancelEditingItemAsync" />
                    }
                    else
                    {
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Outlined.Edit"
                                       Disabled="@_isEditing"
                                       aria-label="Edit row"
                                       OnClick="@context.Actions.StartEditingItemAsync" />
                        <MudIconButton Size="Size.Small"
                                       Icon="@Icons.Material.Outlined.Delete"
                                       Disabled="@_isEditing"
                                       aria-label="Delete row"
                                       OnClick="@(() => DeleteItem(context.Item))" />
                    }
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
</MudPaper>

@code {
    private readonly ApplicationDbContext _context;
    private MudDataGrid<Reward> _dataGrid = null!;
    private List<Reward> _rewards = [];
    private bool _isEditing;

    public Rewards(ApplicationDbContext context)
    {
        _context = context;
    }
    
    protected override async Task OnInitializedAsync()
    {
        _rewards = await RewardService.GetRewardsAsync();
    }
    
    private async Task CreateReward()
    {
        var createDialog = await DialogService.ShowAsync<CreateReward>("Add a new Reward");

        var result = await createDialog.Result;
        if (!result!.Canceled)
        {
            Reward? newReward = await createDialog.GetReturnValueAsync<Reward>();
            if (newReward is not null)
            {
                createDialog.Close();
                
                await RewardService.CreateRewardAsync(newReward);
                _rewards = await RewardService.GetRewardsAsync();
            }
            else
            {
                Snackbar.Add("Failed to Save the new Reward", Severity.Error);
            }
        }
    }
    
    private void StartedEditingItem(Reward item)
    {
        _isEditing = true;
    }

    private Task<DataGridEditFormAction> CanceledEditingItem(Reward item)
    {
        _isEditing = false;

        return Task.FromResult(DataGridEditFormAction.Close);
    }

    private async Task<DataGridEditFormAction> CommittedItemChanges(Reward item)
    {
        // Perform validation
        if (string.IsNullOrWhiteSpace(item.Name))
        {
            return DataGridEditFormAction.KeepOpen;
        }
        
        try
        {
            await RewardService.UpdateRewardAsync(item);
        }
        catch (Exception e)
        {
            Snackbar.Add("Failed to Save the Reward", Severity.Error);
            
            return DataGridEditFormAction.KeepOpen;
        }
        
        _isEditing = false;
        _rewards = await RewardService.GetRewardsAsync();

        return DataGridEditFormAction.Close;
    }

    private async Task DeleteItem(Reward item)
    {
        await RewardService.DeleteRewardAsync(item);
        
        _rewards.Remove(item);
    } 

}